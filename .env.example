# Neftis — server-only environment variables
# Never commit real credentials. Configure production values in Vercel.

# Neon PostgreSQL — use the pooled connection string from the Neon Console
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neftis?sslmode=require

# Neon Managed Better Auth
NEON_AUTH_BASE_URL=https://ep-late-morning-bi3k2igj.neonauth.c-5.ap-southeast-1.aws.neon.tech/neftis/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters

# Public application origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encrypt BYOK provider credentials at rest (32 bytes, base64 encoded)
AI_CREDENTIALS_ENCRYPTION_KEY=

# Optional platform-managed Gemini fallback. BYOK remains independently supported.
GEMINI_API_KEY=

# Cloudflare R2 private object storage (S3-compatible API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=neftis-private
R2_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto

# Google and GitHub OAuth credentials are configured in Neon Auth,
# not in the Next.js environment. Google shared credentials are for development only.
