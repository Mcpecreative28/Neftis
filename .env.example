# Neftis — server-only environment variables
# Never commit real credentials. Configure production values in Vercel.

# Application
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# OAuth providers (configure redirect URLs in each provider console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypt BYOK provider credentials at rest (32 bytes, base64 encoded)
AI_CREDENTIALS_ENCRYPTION_KEY=

# Optional platform-managed Gemini fallback. BYOK remains independently supported.
GEMINI_API_KEY=

# Cloudflare R2 private object storage (S3-compatible API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=neftis-private
R2_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto

# Optional public origin used only for application links, not public file access
NEXT_PUBLIC_APP_URL=http://localhost:3000
